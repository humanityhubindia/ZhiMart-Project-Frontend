# Origin of the Rust backend API, without a trailing slash and without /api/v1.
# Leave EMPTY to call the API on the same origin as the frontend (recommended):
#   - in dev, Vite proxies /api -> http://127.0.0.1:8080 (see vite.config.ts)
#   - in prod, serve /api from the same origin via your reverse proxy
# The admin refresh cookie is SameSite=Strict + HttpOnly, so a cross-site API origin
# will NOT work for session restore/refresh.
VITE_API_BASE_URL=
