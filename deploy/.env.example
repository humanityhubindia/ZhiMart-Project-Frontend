# Used by deploy/docker-compose.prod.yml only. Copy to deploy/.env on the server.
# The API's domain, without https:// (DNS A record must point at this server,
# "DNS only" / grey cloud in Cloudflare so Caddy can get the certificate).
API_DOMAIN=api.zhimartcrackers.com

# ---------------------------------------------------------------------------
# NOT read from this file: pricing and delivery are API settings and belong in
# backend/.env (env_file of the api service). Shown here for reference with their
# defaults; see backend/.env.example and backend/README.md "Pricing".
#   STANDARD_DISCOUNT_PERCENT=80   (orders below BULK_MIN_ORDER_RUPEES: 80% off MRP)
#   BULK_MIN_ORDER_RUPEES=5000     (bulk/price-list pricing from this list total)
#   BULK_DISCOUNT_PERCENT=85       (storefront label only)
#   DELIVERY_FEE_RUPEES=500        (charged when the subtotal is below the minimum)
#   FREE_DELIVERY_MIN_RUPEES=5000  (free delivery from this subtotal; 0 = always free)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# NOT read from this file: the Google Sheets order sync is an API setting and
# belongs in backend/.env. Listed here for reference; see backend/.env.example
# and backend/README.md "Google Sheets order sync" (step-by-step setup).
#   GOOGLE_SHEETS_ENABLED=false        (true = sync every new order to the sheet)
#   GOOGLE_OAUTH_CLIENT_ID=            (OAuth client, ….apps.googleusercontent.com)
#   GOOGLE_OAUTH_CLIENT_SECRET=        (secret: never commit)
#   GOOGLE_OAUTH_REFRESH_TOKEN=        (from `zhimart-backend google-auth`; secret)
#   GOOGLE_SHEETS_SPREADSHEET_ID=      (the ID from the sheet URL)
#   GOOGLE_SHEETS_TAB=Orders           (tab name; created if missing)
#   GOOGLE_OAUTH_REDIRECT_PORT=53682   (google-auth loopback port only)
# ---------------------------------------------------------------------------
