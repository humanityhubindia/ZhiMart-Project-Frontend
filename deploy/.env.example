# Used by deploy/docker-compose.prod.yml only. Copy to deploy/.env on the server.
# The API's domain, without https:// (DNS A record must point at this server,
# "DNS only" / grey cloud in Cloudflare so Caddy can get the certificate).
API_DOMAIN=api.zhimartcrackers.com

# ---------------------------------------------------------------------------
# NOT read from this file: pricing and delivery are API settings and belong in
# backend/.env (env_file of the api service). Shown here for reference with their
# defaults; see backend/.env.example and backend/README.md "Pricing".
#   STANDARD_DISCOUNT_PERCENT=75   (orders below BULK_MIN_ORDER_RUPEES: 75% off MRP)
#   BULK_MIN_ORDER_RUPEES=10000    (bulk/price-list pricing from this list total)
#   BULK_DISCOUNT_PERCENT=85       (storefront label only)
#   DELIVERY_FEE_RUPEES=350        (charged when the subtotal is below the minimum)
#   FREE_DELIVERY_MIN_RUPEES=5000  (free delivery from this subtotal; 0 = always free)
# ---------------------------------------------------------------------------
