# One origin for the storefront, the admin console and the API: the admin refresh
# cookie is SameSite=Strict, so /api must be served from the same domain as the SPA.
# Caddy gets and renews the HTTPS certificate for SITE_DOMAIN automatically.

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Vite's hashed bundles never change; everything else is revalidated.
		@hashed path_regexp \.[A-Za-z0-9_-]{8,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# Single-page app: unknown paths fall back to index.html.
		try_files {path} /index.html
		file_server
	}
}
