# API-only server: the storefront is hosted on Cloudflare Pages and calls this API
# cross-origin (VITE_API_BASE_URL=https://{API_DOMAIN}; backend ALLOWED_ORIGINS lists the
# storefront origins). Caddy gets and renews the HTTPS certificate for API_DOMAIN.

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}
