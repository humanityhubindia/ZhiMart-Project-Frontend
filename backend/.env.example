# Zhi-Mart backend configuration.
# Copy to .env for local development:   cp .env.example .env
#
# Values here are SAFE DEV DEFAULTS. Never commit a real .env. In production,
# inject these from a secret manager (AWS Secrets Manager / SSM Parameter Store).
# "Default" below is what applies when the variable is unset.
# Comments are on their own lines on purpose: inline "# ..." after a value is
# not portable across env-file parsers (systemd, ECS, docker --env-file).

# ===========================================================================
# Runtime
# ===========================================================================
# production | development. Default: production.
# production enforces COOKIE_SECURE=true, EMAIL_PROVIDER=ses, https-only
# ALLOWED_ORIGINS, and enables JSON logs + HSTS.
APP_ENV=development

# Listen address. Default: 0.0.0.0:8080. Loopback is enough for local dev
# (the Vite dev server proxies /api to 127.0.0.1:8080).
BIND_ADDR=127.0.0.1:8080

# Log filter (tracing EnvFilter syntax).
# Default: info,zhimart_backend=info,tower_http=info,sqlx=warn,aws=warn
RUST_LOG=info,zhimart_backend=debug,tower_http=info,sqlx=warn,aws=warn

# Apply database migrations at server start. Set to false if you run
# `zhimart-backend migrate` as a separate deploy step. Default: true.
AUTO_MIGRATE=true

# ===========================================================================
# Database (PostgreSQL)
# The CLI commands (migrate / create-admin / reset-password) need ONLY this.
# ===========================================================================
# Matches docker-compose.yml (dev only). In production append
# ?sslmode=verify-full (or require) and use a dedicated least-privilege role.
DATABASE_URL=postgres://zhimart:zhimart@127.0.0.1:5433/zhimart
# Pool size. Default: 20.
DB_MAX_CONNECTIONS=20
# Warm connections kept open. Default: 2.
DB_MIN_CONNECTIONS=2
# Seconds to wait for a pooled connection before answering 503. Default: 5.
DB_ACQUIRE_TIMEOUT_SECS=5

# ===========================================================================
# Secrets — REQUIRED. Each at least 32 bytes, and different from each other.
# Generate each one with:
#     openssl rand -base64 48
#
# Rotation:
#   JWT_SECRET  -> every outstanding access token stops verifying; the SPA
#                  transparently calls /auth/refresh (refresh tokens are opaque,
#                  DB-backed, and unaffected). To force everyone to log in
#                  again, revoke sessions in the database.
#   OTP_PEPPER  -> only invalidates sign-in codes currently in flight.
# ===========================================================================
JWT_SECRET=
OTP_PEPPER=

# ===========================================================================
# Tokens and sessions
# ===========================================================================
# Default: zhimart-api
JWT_ISSUER=zhimart-api
# Default: zhimart-admin
JWT_AUDIENCE=zhimart-admin
# Access token lifetime, 60..3600. Default: 900.
ACCESS_TOKEN_TTL_SECS=900
# Absolute session lifetime, at most 30 days. Default: 2592000.
SESSION_TTL_SECS=2592000

# ===========================================================================
# OTP / login hardening
# ===========================================================================
# Code validity, 60..900. Default: 300.
OTP_TTL_SECS=300
# Wrong codes allowed per challenge, 1..10. Default: 5.
OTP_MAX_ATTEMPTS=5
# Default: 60.
OTP_RESEND_COOLDOWN_SECS=60
# 0..10. Default: 3.
OTP_MAX_RESENDS=3
# Failed passwords before the account is locked, 1..20. Default: 5.
LOGIN_MAX_FAILURES=5
# Default: 900.
LOGIN_LOCKOUT_SECS=900

# ===========================================================================
# Browser security
# ===========================================================================
# Secure refresh cookie (with the __Secure- prefix). MUST be true in
# production (HTTPS). false only for local http development. Default: true.
COOKIE_SECURE=false

# Comma-separated exact origins: scheme://host[:port], no trailing slash.
# Used for CORS and for the CSRF Origin check. Keep the dev origin even with
# the Vite proxy: browsers still send "Origin: http://localhost:5173" on POST.
# Production: your https admin origin(s) only. Default: empty (same-origin only).
ALLOWED_ORIGINS=http://localhost:5173

# ===========================================================================
# Network edge
# ===========================================================================
# Comma-separated IPs/CIDRs of the reverse proxies / load balancers that are
# allowed to set X-Forwarded-For. Leave EMPTY when clients connect directly:
# X-Forwarded-For is then ignored entirely and cannot be spoofed. Behind a
# proxy, list ONLY that proxy's addresses (e.g. ALB subnets
# 10.0.1.0/24,10.0.2.0/24). Ranges broader than /8 (IPv4) or /32 (IPv6) are
# rejected at startup. Trusted peers are also exempt from the per-IP open
# connection cap (64), since every proxied connection comes from them.
TRUSTED_PROXIES=

# Requests per minute per client IP for the whole /api tree (burst = 1/4 of
# it). Default: 300. Sized for one admin with a few dashboard tabs open: each
# visible tab polls /admin/sync every ~5 s plus list refetches, ~36/min worst
# case, so 3 tabs use ~110/min. Raise it if many staff share one NAT address.
# (Checkout POST /orders has its own fixed limit: 6/min, burst 3.)
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Requests per minute per client IP for login / OTP verify / OTP resend. Default: 10.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Per-request deadline in seconds (503 when exceeded). Default: 15.
REQUEST_TIMEOUT_SECS=15
# Maximum request body size in bytes (413 when exceeded). Default: 65536.
MAX_BODY_BYTES=65536
# In-flight request cap; excess requests are shed with 503. Default: 1024.
MAX_CONCURRENT_REQUESTS=1024

# ===========================================================================
# Payments (Razorpay). See README "Payments (Razorpay)".
# ===========================================================================
# Master switch for online payments. Default: false (launch setting).
#   false => orders are "pay later": stock is deducted at once, the admins are
#            emailed, and an admin records the payment manually (mark paid).
#            The RAZORPAY_* variables below are then OPTIONAL and unused.
#   true  => Razorpay Checkout; RAZORPAY_KEY_ID / _KEY_SECRET / _WEBHOOK_SECRET
#            become REQUIRED and are validated at startup.
RAZORPAY_ENABLED=false

# true  => every product is charged ₹1 per unit (orders flagged isTest and
#          excluded from revenue). Works with test OR live keys; with LIVE keys
#          real ₹1 payments are taken.
# false => real prices. With APP_ENV=production this requires live keys.
# Default: false. Dev default below: true.
PAYMENT_TEST_MODE=true

# --- Only needed when RAZORPAY_ENABLED=true ---
# Dashboard → Account & Settings → API Keys. rzp_test_… (test mode) or
# rzp_live_… (live). The key id is public (sent to the browser).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Shown once when the key is generated in the dashboard. Server-side only;
# never commit it.
RAZORPAY_KEY_SECRET=
# You choose this value; paste the SAME value into Dashboard → Webhooks →
# Secret. At least 16 characters, different from the key secret. Generate:
#     openssl rand -hex 32
RAZORPAY_WEBHOOK_SECRET=

# --- (end of RAZORPAY_ENABLED=true-only settings) ---

# Minutes an unpaid order keeps its stock reserved (online payments only) before it is cancelled and
# the stock released, 10..1440. Default: 30.
PAYMENT_EXPIRY_MINUTES=30
# Shown in Razorpay Checkout and the storefront, 1-80 chars.
# Default: Zhi-Mart Fireworks.
STORE_NAME=Zhi-Mart Fireworks

# TESTS ONLY: point the Razorpay client at a mock server (http allowed outside
# production; cannot be overridden in production). Default: https://api.razorpay.com
# RAZORPAY_API_BASE=https://api.razorpay.com

# ===========================================================================
# Order emails (admin notification + customer confirmation)
# ===========================================================================
# Email the admins about every new order. Default: true. With online payments
# the email goes out when the payment is CONFIRMED (abandoned checkouts never
# email); in pay-later mode, when the order is placed. Delivered through a
# transactional outbox with retries (see README).
ORDER_NOTIFICATION_ENABLED=true
# Comma-separated recipients (max 20). Empty => every ACTIVE admin's login
# email. With SES in sandbox, every recipient must be a verified identity.
ORDER_NOTIFICATION_EMAILS=
# Email every customer an "order confirmed" message with their private
# tracking link ({PUBLIC_SITE_URL}/?page=order&order=ZM-…#t=<token>), sent at
# the same moment as the admin email. Default: true. Requires SES production
# access (the sandbox only delivers to verified addresses).
CUSTOMER_ORDER_EMAIL_ENABLED=true
# Public storefront origin (https://, no trailing slash). Builds the customer
# tracking links and the admin email's "Open admin console" button.
# REQUIRED in production when CUSTOMER_ORDER_EMAIL_ENABLED=true; in development
# an empty value falls back to http://localhost:5173.
PUBLIC_SITE_URL=

# ===========================================================================
# Email
# ===========================================================================
# ses | log. Default: ses. "log" prints codes to the server log and is refused
# when APP_ENV=production.
EMAIL_PROVIDER=log

# Verified SES identity. Required when EMAIL_PROVIDER=ses.
SES_FROM_ADDRESS="Zhi-Mart Admin <no-reply@example.com>"
# Optional SES configuration set (bounce/complaint/delivery event publishing).
SES_CONFIGURATION_SET=

# AWS SDK (standard credential chain: env vars, profile/SSO, ECS task role,
# EC2 instance profile, EKS IRSA). Prefer a role in production; for local SES
# testing use a named profile rather than static keys.
AWS_REGION=ap-south-1
# AWS_PROFILE=zhimart-dev

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crackers-pics
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ===========================================================================
# Pricing tiers and delivery charge. See README "Pricing: bulk vs standard".
# ===========================================================================
# An order whose total AT PRICE-LIST PRICES (products.price, ~85% off MRP)
# reaches this many rupees is charged the list prices ("bulk"). Below it,
# EVERY line is charged the "standard" price. 0..10000000; 0 = always bulk.
# Default: 5000.
BULK_MIN_ORDER_RUPEES=5000
# Standard price = MRP x (100 - this) / 100, rounded UP to a whole rupee,
# never below the list price (nor above the MRP). 0..99. Default: 80.
STANDARD_DISCOUNT_PERCENT=80
# Typical price-list discount, shown by the storefront ("85% off on orders of
# ₹5,000+"). Label only: bulk orders are charged the actual list prices.
# STANDARD_DISCOUNT_PERCENT..99. Default: 85.
BULK_DISCOUNT_PERCENT=85
# Flat delivery charge in whole rupees, added to every order whose subtotal
# (goods after tier pricing) is below FREE_DELIVERY_MIN_RUPEES. Included in the
# payable total (Razorpay amount, refunds, revenue). Under PAYMENT_TEST_MODE it
# is charged as ₹1. 0..10000. Default: 500.
DELIVERY_FEE_RUPEES=500
# Subtotal (whole rupees) from which delivery is free; exactly this amount ships
# free. 0 = delivery always free. 0..10000000. Default: 5000.
FREE_DELIVERY_MIN_RUPEES=5000

# ===========================================================================
# Google Sheets order sync. See README "Google Sheets order sync".
# Every order placed after migration 20261014000012 gets one row in the sheet,
# appended at checkout and rewritten in place on every change (payment, status,
# courier/LR, refunds). Done by a background worker: checkout never waits for
# Google, and failures are retried with backoff (rows are never dropped).
# ===========================================================================
# Master switch. Default: false. When true, ALL of the GOOGLE_OAUTH_* and
# GOOGLE_SHEETS_SPREADSHEET_ID values below are REQUIRED (startup fails without
# them). While false, orders are still queued in the database; enabling later
# syncs every order placed since the migration (DELETE FROM sheet_sync_queue;
# first to skip them).
GOOGLE_SHEETS_ENABLED=false
# OAuth client (Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client IDs). "Desktop app" type, or "Web application" with
# http://127.0.0.1:53682/ in its Authorized redirect URIs. The secret is a
# password: never commit it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Long-lived refresh token, printed by:  zhimart-backend google-auth
# (needs only the two values above). Publish the OAuth consent screen to
# "In production" first, or Google expires this token after 7 days.
# Secret: never commit it, never log it.
GOOGLE_OAUTH_REFRESH_TOKEN=
# The long ID from the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# (pasting the whole URL also works). The Google account used for google-auth
# must be able to EDIT this sheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab (sheet) name; created with a header row if missing. Default: Orders.
GOOGLE_SHEETS_TAB=Orders
# Loopback port that `google-auth` listens on for Google's redirect
# (http://127.0.0.1:<port>/). Default: 53682. Only used by google-auth.
# GOOGLE_OAUTH_REDIRECT_PORT=53682

# TESTS ONLY: point the OAuth token endpoint / Sheets API at a mock server
# (http allowed outside production; cannot be overridden in production).
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_SHEETS_API_BASE=https://sheets.googleapis.com
